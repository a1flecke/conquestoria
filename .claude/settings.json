{
  "permissions": {
    "allow": [
      "Read(//tmp/pr-bodies/**)",
      "Write(//tmp/pr-bodies/**)",
      "Edit(//tmp/pr-bodies/**)",
      "Read(//private/tmp/pr-bodies/**)",
      "Write(//private/tmp/pr-bodies/**)",
      "Edit(//private/tmp/pr-bodies/**)",
      "Bash(bash scripts/pr-body.sh:*)",
      "Bash(./scripts/pr-body.sh:*)",
      "Bash(sh scripts/stop-local-verification.sh:*)",
      "Bash(./scripts/stop-local-verification.sh:*)",
      "Bash(sh scripts/launch-local-verification.sh:*)",
      "Bash(./scripts/launch-local-verification.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-src-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-review-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-commit-on-main.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-pattern-kill.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-green-before-push.sh",
            "timeout": 1800
          }
        ]
      },
      {
        "matcher": "Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-claire-paths.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
