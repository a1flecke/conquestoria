{
  "$schema": "https://opencode.ai/config.json",

  // Remote browser sessions are private to the tailnet; do not also publish
  // transcripts through OpenCode's separate sharing feature.
  "share": "disabled",

  // V2 appends an agent's permission rules after global rules, and the last
  // matching rule wins. This gives the Conquestoria build agent routine
  // repository authority without weakening the user's global credential
  // protections in other projects. There is deliberately no catch-all
  // `shell: *` rule here: it would override every global allow not repeated
  // below. The global `shell: * ask` is the baseline, so anything not listed
  // here still asks.
  "agents": {
    "build": {
      "permissions": [
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "find * -delete*", "effect": "ask" },
        { "action": "shell", "resource": "find * -exec*", "effect": "ask" },
        { "action": "shell", "resource": "find * -ok*", "effect": "ask" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "sed -n *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "cat *.env*", "effect": "ask" },
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "command -v *", "effect": "allow" },

        { "action": "shell", "resource": "./scripts/run-with-mise.sh yarn *", "effect": "allow" },
        // Narrow task dispatcher (#1256): a fixed task table, no flags, only validated tests/ paths are
        // forwarded. It can run nothing outside that table, unlike the generic wrapper above.
        { "action": "shell", "resource": "./scripts/dev.sh *", "effect": "allow" },
        // Agent-authored throwaway analysis scripts live in OpenCode's scratch dir; run them through
        // the mise wrapper (never bare node), and only from that dir.
        { "action": "shell", "resource": "./scripts/run-with-mise.sh node /private/var/folders/*/*/T/opencode/*", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/run-with-mise.sh node /var/folders/*/*/T/opencode/*", "effect": "allow" },
        { "action": "shell", "resource": "mise trust mise.toml", "effect": "allow" },

        // Shared host: launch/stop verification runs and write PR bodies through the repo's
        // helpers. PR bodies live only in /tmp/pr-bodies (scripts/pr-body.sh); a run is stopped
        // by recorded pid (scripts/stop-local-verification.sh), never by name.
        { "action": "shell", "resource": "./scripts/pr-body.sh *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/launch-local-verification.sh *", "effect": "allow" },
        { "action": "shell", "resource": "./scripts/stop-local-verification.sh *", "effect": "allow" },
        { "action": "shell", "resource": "pkill *", "effect": "deny" },
        { "action": "shell", "resource": "killall *", "effect": "deny" },

        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git branch *", "effect": "allow" },
        { "action": "shell", "resource": "git branch -d *", "effect": "ask" },
        { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
        { "action": "shell", "resource": "git branch --delete *", "effect": "ask" },
        { "action": "shell", "resource": "git switch *", "effect": "allow" },
        { "action": "shell", "resource": "git checkout *", "effect": "allow" },
        { "action": "shell", "resource": "git worktree add *", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
        { "action": "shell", "resource": "git config --worktree --get core.hooksPath", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
        { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
        { "action": "shell", "resource": "git add *", "effect": "allow" },
        { "action": "shell", "resource": "git commit *", "effect": "allow" },
        { "action": "shell", "resource": "git fetch *", "effect": "allow" },
        { "action": "shell", "resource": "git pull *", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "allow" },
        // Routine rebase onto the latest origin/main (#1256): a fixed, no-argument script that only runs
        // `git fetch origin main` + `git rebase origin/main` and refuses main, a detached HEAD, a dirty
        // tree and a rebase already in progress. No wildcard, so it cannot take an argument.
        { "action": "shell", "resource": "./scripts/sync-main.sh", "effect": "allow" },
        // Publishing the rebased branch (#1260): a fixed, no-argument script that pushes only the current
        // feature branch to origin under the same name, with a lease pinned to the remote tip this clone last
        // saw, and only once the branch contains the latest origin/main. Raw force pushes stay denied/asking.
        { "action": "shell", "resource": "./scripts/push-branch.sh", "effect": "allow" },
        // Deliberately no static allow for the raw "git rebase origin/main" here.
        // Root-caused after this commit: the real reason it prompted was a
        // field-name bug in the model-approval plugin (checked "cwd"/
        // "directory" but OpenCode's shell tool input is "workdir"), fixed
        // upstream in that plugin. With that fixed, "ask" (the default
        // below) already routes to the plugin's deterministic
        // trusted-worktree preflight, which verifies this exact command
        // per-invocation and allows it reliably. A static allow here would
        // be worse: "git rebase" is in the plugin's sensitive-even-if-
        // allowed list but not its allow-bypass shortlist, so an "allow"
        // arriving from this layer gets overwritten by a full model review
        // instead of using the reliable deterministic path.

        { "action": "shell", "resource": "gh issue *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr *", "effect": "allow" },
        { "action": "shell", "resource": "gh repo *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
        { "action": "shell", "resource": "gh issue delete *", "effect": "ask" },
        { "action": "shell", "resource": "gh repo edit *", "effect": "ask" },
        { "action": "shell", "resource": "gh repo delete *", "effect": "deny" },
        { "action": "shell", "resource": "gh auth status", "effect": "allow" },

        { "action": "shell", "resource": "sudo *", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
        { "action": "shell", "resource": "git clean *", "effect": "deny" },
        { "action": "shell", "resource": "git restore *", "effect": "deny" },
        { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
        { "action": "shell", "resource": "git push --force *", "effect": "deny" },
        { "action": "shell", "resource": "git push * --force *", "effect": "deny" },
        { "action": "shell", "resource": "git push * +*", "effect": "deny" },
        { "action": "shell", "resource": "git push --delete *", "effect": "deny" },
        { "action": "shell", "resource": "git push * --delete *", "effect": "deny" },
        { "action": "shell", "resource": "git push * :*", "effect": "deny" },
        { "action": "shell", "resource": "git push --tags*", "effect": "deny" },
        { "action": "shell", "resource": "git push * --tags*", "effect": "deny" },
        { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
        { "action": "shell", "resource": "git push * --mirror*", "effect": "deny" },
        // Keep the lease form as ask so the approval plugin can verify the
        // trusted worktree, current feature branch, exact refspec, and clean
        // rebase state before allowing it. Do not turn this into a broad
        // static allow rule.
        { "action": "shell", "resource": "git push --force-with-lease *", "effect": "ask" },
        { "action": "shell", "resource": "git push * --force-with-lease", "effect": "ask" },
        { "action": "shell", "resource": "git push * --force-with-lease *", "effect": "ask" },
        { "action": "shell", "resource": "tailscale *", "effect": "deny" },
        { "action": "shell", "resource": "networksetup *", "effect": "deny" },
        { "action": "shell", "resource": "security *", "effect": "deny" },
        { "action": "shell", "resource": "diskutil *", "effect": "deny" },

        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
